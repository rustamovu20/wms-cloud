[Unit]
Description=NimbusWMS (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/wms
Environment="WMS_SECRET=please-change-this-secret"
Environment="WMS_DB=/opt/wms/wms.db"
ExecStart=/opt/wms/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
